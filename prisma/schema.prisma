// NEXT TAXI — PostgreSQL + PostGIS schema
// Money: integer UZS (so'm). Coordinates: WGS84 (EPSG:4326).
// PostGIS columns (geography/geometry), partial unique indexes, CHECK constraints
// and immutability triggers are added in hand-written SQL migrations because
// Prisma cannot express them. Always apply migrations with `prisma migrate deploy`.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  engineType      = "client"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pgcrypto]
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  PASSENGER
  DRIVER
  SUPER_ADMIN
  CITY_MANAGER
  SUPPORT_OPERATOR
  FINANCE_MANAGER
  COMPLIANCE_REVIEWER
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum DriverStatus {
  PENDING_DOCUMENTS
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum DriverAvailability {
  OFFLINE
  ONLINE
}

enum DocumentType {
  DRIVER_LICENSE
  PASSPORT_ID
  VEHICLE_REGISTRATION
  INSURANCE
  VEHICLE_PHOTO
  SELFIE
  TAXI_LICENSE
  SELF_EMPLOYED_CERT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  INACTIVE
}

enum VehicleClass {
  ECONOMY
  COMFORT
}

enum CityStatus {
  ACTIVE
  INACTIVE
}

enum RideStatus {
  REQUESTED
  SEARCHING
  ASSIGNED
  ARRIVING
  ARRIVED
  IN_PROGRESS
  COMPLETED
  SETTLED
  CANCELLED
  NO_DRIVER
}

enum ActorType {
  PASSENGER
  DRIVER
  SYSTEM
  ADMIN
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CLICK
  PAYME
}

enum PaymentStatus {
  PENDING
  COLLECTED_BY_DRIVER
  FAILED
  VOIDED
}

enum LedgerAccount {
  DRIVER_COMMISSION_RECEIVABLE
  PLATFORM_COMMISSION_REVENUE
  PLATFORM_CASH
  ADJUSTMENTS
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerEventType {
  COMMISSION_ACCRUED
  COMMISSION_SETTLED
  COMMISSION_REVERSED
}

enum SettlementMethod {
  CASH_AT_OFFICE
  BANK_TRANSFER
  CARD_TRANSFER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  RIDE
  PAYMENT
  ACCOUNT
  DRIVER_APPLICATION
  SAFETY
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

// ───────────────────────────── Identity & access ─────────────────────────────

model User {
  id        String     @id @default(uuid()) @db.Uuid
  phone     String     @unique // E.164, e.g. +998901234567
  fullName  String?    @map("full_name")
  status    UserStatus @default(ACTIVE)
  locale    String     @default("uz")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Soft-deletion for account-deletion requests; PII is anonymised by the retention job.
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(3)

  roles            UserRole[]
  sessions         Session[]
  passengerProfile PassengerProfile?
  driverProfile    DriverProfile?
  ridesAsPassenger Ride[]            @relation("RidePassenger")
  fareQuotes       FareQuote[]
  ratingsGiven     Rating[]          @relation("RatingRater")
  ratingsReceived  Rating[]          @relation("RatingRatee")
  supportTickets   SupportTicket[]   @relation("TicketUser")
  assignedTickets  SupportTicket[]   @relation("TicketAssignee")
  ticketMessages   TicketMessage[]
  auditLogs        AuditLog[]
  incidentsFiled   SafetyIncident[]  @relation("IncidentReporter")
  incidentsHandled SafetyIncident[]  @relation("IncidentHandler")
  idempotencyKeys  IdempotencyKey[]

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  // Optional city scope (used for CITY_MANAGER). NULL = all cities.
  cityId    String?  @map("city_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  city City? @relation(fields: [cityId], references: [id])

  @@unique([userId, role])
  @@map("user_roles")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  app        String // passenger | driver | admin
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  key            String
  endpoint       String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// ───────────────────────────── Profiles ─────────────────────────────

model PassengerProfile {
  userId      String   @id @map("user_id") @db.Uuid
  ratingSum   Int      @default(0) @map("rating_sum")
  ratingCount Int      @default(0) @map("rating_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passenger_profiles")
}

model DriverProfile {
  userId          String             @id @map("user_id") @db.Uuid
  status          DriverStatus       @default(PENDING_DOCUMENTS)
  availability    DriverAvailability @default(OFFLINE)
  cityId          String?            @map("city_id") @db.Uuid
  fleetId         String?            @map("fleet_id") @db.Uuid
  licenseNumber   String?            @map("license_number")
  licenseExpiry   DateTime?          @map("license_expiry") @db.Date
  rejectionReason String?            @map("rejection_reason")
  suspendedReason String?            @map("suspended_reason")
  approvedAt      DateTime?          @map("approved_at") @db.Timestamptz(3)
  approvedById    String?            @map("approved_by_id") @db.Uuid
  ratingSum       Int                @default(0) @map("rating_sum")
  ratingCount     Int                @default(0) @map("rating_count")
  lastOnlineAt    DateTime?          @map("last_online_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  city        City?            @relation(fields: [cityId], references: [id])
  fleet       Fleet?           @relation(fields: [fleetId], references: [id])
  documents   DriverDocument[]
  vehicles    DriverVehicle[]
  location    DriverLocation?
  rides       Ride[]           @relation("RideDriver")
  offers      RideOffer[]
  settlements Settlement[]

  @@index([status, availability, cityId])
  @@map("driver_profiles")
}

model DriverDocument {
  id              String       @id @default(uuid()) @db.Uuid
  driverId        String       @map("driver_id") @db.Uuid
  type            DocumentType
  status          ReviewStatus @default(PENDING)
  storageKey      String       @unique @map("storage_key")
  mimeType        String       @map("mime_type")
  sizeBytes       Int          @map("size_bytes")
  sha256          String
  reviewedById    String?      @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  rejectionReason String?      @map("rejection_reason")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  driver DriverProfile @relation(fields: [driverId], references: [userId], onDelete: Cascade)

  @@index([driverId, type])
  @@index([status])
  @@map("driver_documents")
}

model Fleet {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  cityId       String?  @map("city_id") @db.Uuid
  contactPhone String?  @map("contact_phone")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  city     City?           @relation(fields: [cityId], references: [id])
  drivers  DriverProfile[]
  vehicles Vehicle[]

  @@map("fleets")
}

model Vehicle {
  id              String        @id @default(uuid()) @db.Uuid
  plateNumber     String        @unique @map("plate_number") // normalised, e.g. 70A123BC
  make            String
  model           String
  color           String
  year            Int
  seats           Int           @default(4)
  vehicleClass    VehicleClass  @default(ECONOMY) @map("vehicle_class")
  status          VehicleStatus @default(PENDING_REVIEW)
  rejectionReason String?       @map("rejection_reason")
  cityId          String?       @map("city_id") @db.Uuid
  fleetId         String?       @map("fleet_id") @db.Uuid
  reviewedById    String?       @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?     @map("reviewed_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  city    City?           @relation(fields: [cityId], references: [id])
  fleet   Fleet?          @relation(fields: [fleetId], references: [id])
  drivers DriverVehicle[]
  rides   Ride[]

  @@map("vehicles")
}

model DriverVehicle {
  id        String   @id @default(uuid()) @db.Uuid
  driverId  String   @map("driver_id") @db.Uuid
  vehicleId String   @map("vehicle_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  driver  DriverProfile @relation(fields: [driverId], references: [userId], onDelete: Cascade)
  vehicle Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([driverId, vehicleId])
  @@map("driver_vehicles")
}

// Latest known position per driver. `geog` (geography Point) is a generated column (SQL migration).
model DriverLocation {
  driverId   String   @id @map("driver_id") @db.Uuid
  lat        Float
  lng        Float
  heading    Float?
  speedKmh   Float?   @map("speed_kmh")
  accuracyM  Float?   @map("accuracy_m")
  recordedAt DateTime @map("recorded_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  driver DriverProfile @relation(fields: [driverId], references: [userId], onDelete: Cascade)

  @@map("driver_locations")
}

// ───────────────────────────── Geography & pricing ─────────────────────────────

model City {
  id                   String     @id @default(uuid()) @db.Uuid
  slug                 String     @unique
  name                 String // Uzbek Latin
  nameRu               String?    @map("name_ru")
  nameEn               String?    @map("name_en")
  region               String
  timezone             String     @default("Asia/Tashkent")
  status               CityStatus @default(INACTIVE)
  centerLat            Float?     @map("center_lat")
  centerLng            Float?     @map("center_lng")
  defaultZoom          Float      @default(13) @map("default_zoom")
  operatingHoursStart  String     @default("06:00") @map("operating_hours_start") // HH:mm local
  operatingHoursEnd    String     @default("23:00") @map("operating_hours_end")
  searchRadiusMeters   Int        @default(5000) @map("search_radius_meters")
  offerTimeoutSeconds  Int        @default(20) @map("offer_timeout_seconds")
  offerBatchSize       Int        @default(1) @map("offer_batch_size")
  maxOffersPerRide     Int        @default(8) @map("max_offers_per_ride")
  searchTimeoutSeconds Int        @default(180) @map("search_timeout_seconds")
  maxDriverDebt        Int        @default(200000) @map("max_driver_debt") // UZS of unpaid commission before driver is blocked from going online
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  zones      ServiceZone[]
  tariffs    Tariff[]
  rides      Ride[]
  quotes     FareQuote[]
  drivers    DriverProfile[]
  vehicles   Vehicle[]
  fleets     Fleet[]
  staffRoles UserRole[]

  @@map("cities")
}

// `area` (geometry Polygon, 4326) is generated from `boundary` (GeoJSON) in SQL.
model ServiceZone {
  id        String   @id @default(uuid()) @db.Uuid
  cityId    String   @map("city_id") @db.Uuid
  name      String
  boundary  Json // GeoJSON Polygon geometry
  isActive  Boolean  @default(true) @map("is_active")
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  city  City   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  rides Ride[]

  @@index([cityId])
  @@map("service_zones")
}

// Tariffs are versioned and never edited in place: a change creates a new version.
model Tariff {
  id              String       @id @default(uuid()) @db.Uuid
  cityId          String       @map("city_id") @db.Uuid
  vehicleClass    VehicleClass @map("vehicle_class")
  name            String
  version         Int
  isActive        Boolean      @default(true) @map("is_active")
  baseFare        Int          @map("base_fare")
  perKm           Int          @map("per_km")
  perMinute       Int          @map("per_minute")
  minimumFare     Int          @map("minimum_fare")
  roundingStep    Int          @default(500) @map("rounding_step")
  commissionBps   Int          @map("commission_bps") // 1000 = 10.00%
  quoteTtlSeconds Int          @default(300) @map("quote_ttl_seconds")
  createdById     String?      @map("created_by_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  supersededAt    DateTime?    @map("superseded_at") @db.Timestamptz(3)

  city   City        @relation(fields: [cityId], references: [id], onDelete: Cascade)
  quotes FareQuote[]

  @@unique([cityId, vehicleClass, version])
  @@map("tariffs")
}

model FareQuote {
  id              String       @id @default(uuid()) @db.Uuid
  passengerId     String       @map("passenger_id") @db.Uuid
  cityId          String       @map("city_id") @db.Uuid
  zoneId          String?      @map("zone_id") @db.Uuid
  tariffId        String       @map("tariff_id") @db.Uuid
  tariffVersion   Int          @map("tariff_version")
  vehicleClass    VehicleClass @map("vehicle_class")
  pickupLat       Float        @map("pickup_lat")
  pickupLng       Float        @map("pickup_lng")
  pickupAddress   String?      @map("pickup_address")
  dropoffLat      Float        @map("dropoff_lat")
  dropoffLng      Float        @map("dropoff_lng")
  dropoffAddress  String?      @map("dropoff_address")
  distanceMeters  Int          @map("distance_meters")
  durationSeconds Int          @map("duration_seconds")
  routeProvider   String       @map("route_provider")
  routeGeometry   Json?        @map("route_geometry") // GeoJSON LineString
  baseFare        Int          @map("base_fare")
  distanceFare    Int          @map("distance_fare")
  timeFare        Int          @map("time_fare")
  totalFare       Int          @map("total_fare")
  commissionBps   Int          @map("commission_bps")
  currency        String       @default("UZS")
  expiresAt       DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt          DateTime?    @map("used_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  passenger User   @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  city      City   @relation(fields: [cityId], references: [id])
  tariff    Tariff @relation(fields: [tariffId], references: [id])
  ride      Ride?

  @@index([passengerId, createdAt])
  @@map("fare_quotes")
}

// ───────────────────────────── Rides ─────────────────────────────

model Ride {
  id               String        @id @default(uuid()) @db.Uuid
  code             String        @unique // short human-friendly reference
  passengerId      String        @map("passenger_id") @db.Uuid
  driverId         String?       @map("driver_id") @db.Uuid
  vehicleId        String?       @map("vehicle_id") @db.Uuid
  cityId           String        @map("city_id") @db.Uuid
  zoneId           String?       @map("zone_id") @db.Uuid
  quoteId          String        @unique @map("quote_id") @db.Uuid
  vehicleClass     VehicleClass  @map("vehicle_class")
  status           RideStatus    @default(REQUESTED)
  pickupLat        Float         @map("pickup_lat")
  pickupLng        Float         @map("pickup_lng")
  pickupAddress    String?       @map("pickup_address")
  dropoffLat       Float         @map("dropoff_lat")
  dropoffLng       Float         @map("dropoff_lng")
  dropoffAddress   String?       @map("dropoff_address")
  distanceMeters   Int           @map("distance_meters")
  durationSeconds  Int           @map("duration_seconds")
  quotedFare       Int           @map("quoted_fare")
  finalFare        Int?          @map("final_fare")
  commissionBps    Int           @map("commission_bps")
  commissionAmount Int?          @map("commission_amount")
  driverEarnings   Int?          @map("driver_earnings")
  paymentMethod    PaymentMethod @default(CASH) @map("payment_method")
  passengerNote    String?       @map("passenger_note")
  cancelledBy      ActorType?    @map("cancelled_by")
  cancelReason     String?       @map("cancel_reason")
  requestedAt      DateTime      @default(now()) @map("requested_at") @db.Timestamptz(3)
  searchStartedAt  DateTime?     @map("search_started_at") @db.Timestamptz(3)
  assignedAt       DateTime?     @map("assigned_at") @db.Timestamptz(3)
  arrivedAt        DateTime?     @map("arrived_at") @db.Timestamptz(3)
  startedAt        DateTime?     @map("started_at") @db.Timestamptz(3)
  completedAt      DateTime?     @map("completed_at") @db.Timestamptz(3)
  settledAt        DateTime?     @map("settled_at") @db.Timestamptz(3)
  cancelledAt      DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  version          Int           @default(0)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  passenger      User              @relation("RidePassenger", fields: [passengerId], references: [id])
  driver         DriverProfile?    @relation("RideDriver", fields: [driverId], references: [userId])
  vehicle        Vehicle?          @relation(fields: [vehicleId], references: [id])
  city           City              @relation(fields: [cityId], references: [id])
  zone           ServiceZone?      @relation(fields: [zoneId], references: [id])
  quote          FareQuote         @relation(fields: [quoteId], references: [id])
  statusEvents   RideStatusEvent[]
  offers         RideOffer[]
  payment        Payment?
  ratings        Rating[]
  ledgerEntries  LedgerEntry[]
  supportTickets SupportTicket[]
  incidents      SafetyIncident[]

  @@index([passengerId, createdAt])
  @@index([driverId, createdAt])
  @@index([status])
  @@index([cityId, createdAt])
  @@map("rides")
}

model RideStatusEvent {
  id         String      @id @default(uuid()) @db.Uuid
  rideId     String      @map("ride_id") @db.Uuid
  fromStatus RideStatus? @map("from_status")
  toStatus   RideStatus  @map("to_status")
  actorType  ActorType   @map("actor_type")
  actorId    String?     @map("actor_id") @db.Uuid
  reason     String?
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, createdAt])
  @@map("ride_status_events")
}

model RideOffer {
  id             String      @id @default(uuid()) @db.Uuid
  rideId         String      @map("ride_id") @db.Uuid
  driverId       String      @map("driver_id") @db.Uuid
  status         OfferStatus @default(PENDING)
  distanceMeters Int         @map("distance_meters")
  etaSeconds     Int         @map("eta_seconds")
  sequence       Int
  expiresAt      DateTime    @map("expires_at") @db.Timestamptz(3)
  respondedAt    DateTime?   @map("responded_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  ride   Ride          @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver DriverProfile @relation(fields: [driverId], references: [userId], onDelete: Cascade)

  // A driver is offered a given ride at most once.
  @@unique([rideId, driverId])
  @@index([status, expiresAt])
  @@map("ride_offers")
}

// ───────────────────────────── Money ─────────────────────────────

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  rideId           String        @unique @map("ride_id") @db.Uuid
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  amount           Int
  commissionAmount Int           @map("commission_amount")
  driverEarnings   Int           @map("driver_earnings")
  collectedAt      DateTime?     @map("collected_at") @db.Timestamptz(3)
  confirmedById    String?       @map("confirmed_by_id") @db.Uuid
  providerRef      String?       @map("provider_ref")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  ride Ride @relation(fields: [rideId], references: [id])

  @@map("payments")
}

// Append-only double-entry ledger (UPDATE/DELETE blocked by trigger).
model LedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  transactionId String          @map("transaction_id") @db.Uuid
  eventType     LedgerEventType @map("event_type")
  account       LedgerAccount
  direction     LedgerDirection
  amount        Int
  rideId        String?         @map("ride_id") @db.Uuid
  driverId      String?         @map("driver_id") @db.Uuid
  settlementId  String?         @map("settlement_id") @db.Uuid
  memo          String?
  createdById   String?         @map("created_by_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  ride       Ride?       @relation(fields: [rideId], references: [id])
  settlement Settlement? @relation(fields: [settlementId], references: [id])

  @@index([transactionId])
  @@index([driverId, account])
  @@index([rideId])
  @@index([createdAt])
  @@map("ledger_entries")
}

// Driver → platform commission payment recorded by finance staff.
model Settlement {
  id           String           @id @default(uuid()) @db.Uuid
  driverId     String           @map("driver_id") @db.Uuid
  amount       Int
  method       SettlementMethod
  reference    String?
  note         String?
  recordedById String           @map("recorded_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  driver        DriverProfile @relation(fields: [driverId], references: [userId])
  ledgerEntries LedgerEntry[]

  @@index([driverId, createdAt])
  @@map("settlements")
}

// ───────────────────────────── Feedback, support, safety ─────────────────────────────

model Rating {
  id        String    @id @default(uuid()) @db.Uuid
  rideId    String    @map("ride_id") @db.Uuid
  raterId   String    @map("rater_id") @db.Uuid
  rateeId   String    @map("ratee_id") @db.Uuid
  raterRole ActorType @map("rater_role")
  score     Int
  comment   String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  ride  Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  rater User @relation("RatingRater", fields: [raterId], references: [id])
  ratee User @relation("RatingRatee", fields: [rateeId], references: [id])

  @@unique([rideId, raterId])
  @@index([rateeId])
  @@map("ratings")
}

model SupportTicket {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  rideId       String?        @map("ride_id") @db.Uuid
  app          String // passenger | driver
  category     TicketCategory
  subject      String
  status       TicketStatus   @default(OPEN)
  assignedToId String?        @map("assigned_to_id") @db.Uuid
  resolution   String?
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User            @relation("TicketUser", fields: [userId], references: [id])
  assignedTo User?           @relation("TicketAssignee", fields: [assignedToId], references: [id])
  ride       Ride?           @relation(fields: [rideId], references: [id])
  messages   TicketMessage[]

  @@index([status, createdAt])
  @@index([userId])
  @@map("support_tickets")
}

model TicketMessage {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  isStaff   Boolean  @default(false) @map("is_staff")
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model SafetyIncident {
  id           String           @id @default(uuid()) @db.Uuid
  rideId       String?          @map("ride_id") @db.Uuid
  reportedById String           @map("reported_by_id") @db.Uuid
  reporterRole ActorType        @map("reporter_role")
  severity     IncidentSeverity @default(HIGH)
  status       IncidentStatus   @default(OPEN)
  description  String
  lat          Float?
  lng          Float?
  handledById  String?          @map("handled_by_id") @db.Uuid
  resolution   String?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  ride       Ride? @relation(fields: [rideId], references: [id])
  reportedBy User  @relation("IncidentReporter", fields: [reportedById], references: [id])
  handledBy  User? @relation("IncidentHandler", fields: [handledById], references: [id])

  @@index([status, createdAt])
  @@map("safety_incidents")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}
