# ─────────────────────────────────────────────────────────────
# NEXT TAXI — environment template. Copy to `.env` and fill in.
# Never commit real secrets. Production values go into your host's secret manager.
# ─────────────────────────────────────────────────────────────

# Deployment strictness: development | staging | production.
# Defaults to "production" when NODE_ENV=production. "staging" allows test SMS/OTP echo on a production build.
# APP_ENV=

# Host port for `docker compose up -d db` (use 5433 if another PostgreSQL already uses 5432).
DB_PORT=5432
# PostgreSQL 15+ with PostGIS 3 (managed DB must allow CREATE EXTENSION postgis, pgcrypto).
DATABASE_URL=postgresql://nexttaxi:nexttaxi_dev@localhost:5432/nexttaxi?schema=public
DATABASE_POOL_MAX=10

# Public base URL (HTTPS required in production).
APP_URL=http://localhost:3000
# 32+ random characters: `openssl rand -base64 48`
AUTH_SECRET=change-me-to-a-long-random-string-0123456789
# Set to true only behind a trusted reverse proxy (Railway, Nginx, Cloudflare) so X-Forwarded-For is used for rate limits.
TRUST_PROXY=false

# Login code delivery: sms (uses SMS_PROVIDER) | telegram (Telegram Gateway API — code goes to the
# Telegram account of the entered number; https://gateway.telegram.org, paid per delivered code).
OTP_CHANNEL=sms
# Access token from the Telegram Gateway account settings. Secret — never commit it.
TELEGRAM_GATEWAY_TOKEN=
# Optional: username of a verified Telegram channel to show as the sender.
TELEGRAM_GATEWAY_SENDER=
# With OTP_CHANNEL=telegram: send an SMS instead when the number has no Telegram account.
OTP_SMS_FALLBACK=false
# Cost guard: maximum codes sent per day across all users.
OTP_GLOBAL_DAILY_LIMIT=1000

# SMS for OTP: console (dev only) | eskiz
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# Returns the OTP in the API response for local testing. Rejected when APP_ENV=production.
OTP_DEV_ECHO=true

# Routing: estimate (straight-line × 1.35, dev only) | osrm (self-hosted OSRM with an Uzbekistan OSM extract)
ROUTING_PROVIDER=estimate
OSRM_URL=
# Must be true to run production with estimated routing (not recommended).
ALLOW_ESTIMATED_ROUTING=false

# Geocoding: none (map pin only) | nominatim (self-hosted Nominatim/Photon-compatible endpoint)
GEOCODING_PROVIDER=none
GEOCODING_URL=
GEOCODING_USER_AGENT=NEXT-TAXI/0.1 (contact: ops@example.uz)

# Map style (MapLibre). Defaults: OpenFreeMap positron/dark. Add every origin the style loads from to NEXT_PUBLIC_MAP_ORIGINS (space separated) for the CSP.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_STYLE_DARK_URL=https://tiles.openfreemap.org/styles/dark
NEXT_PUBLIC_MAP_ORIGINS=https://tiles.openfreemap.org

# Private document storage: local (persistent volume) | s3 (R2/B2/MinIO, bucket must be private)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/private
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Dispatch loop: inline (inside the web process) | external (`npm run worker`) | off (use the cron endpoint)
DISPATCH_WORKER=inline
DISPATCH_TICK_MS=2000
# Bearer secret for POST /api/v1/internal/dispatch/tick (24+ chars)
CRON_SECRET=

# Monitoring: optional webhook for error alerts (Slack/Discord-compatible or Telegram relay)
ERROR_WEBHOOK_URL=
LOG_LEVEL=info

# Seed: first SUPER_ADMIN phone (required for `npm run db:seed` in production)
SEED_ADMIN_PHONE=+998900000001
