{
  "name": "next-taxi",
  "version": "0.1.0",
  "private": true,
  "description": "NEXT TAXI — on-demand taxi platform (pilot: G‘uzor, Qashqadaryo, Uzbekistan)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dev": "tsx prisma/seed-dev.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "tsx tests/e2e/run-e2e.ts",
    "test:ui": "playwright test",
    "worker": "tsx scripts/dispatch-worker.ts",
    "db:migrate:prisma": "prisma migrate deploy",
    "maintenance:retention": "tsx scripts/retention.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@prisma/adapter-pg": "6.19",
    "@prisma/client": "6.19",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.108.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.74.0",
    "maplibre-gl": "^5.24.1",
    "next": "15.5",
    "pg": "^8.23.1",
    "react": "19.1",
    "react-dom": "19.1",
    "react-hook-form": "^7.92.0",
    "tailwind-merge": "^3.7.0",
    "zod": "3.25",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5",
    "postcss": "^8.5.33",
    "prisma": "6.19",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
